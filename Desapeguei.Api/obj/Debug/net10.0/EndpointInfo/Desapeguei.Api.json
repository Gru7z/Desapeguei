  "components": {
    "schemas": {
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "LoginInput": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "Produto": {
        "required": [
          "titulo",
          "descricao",
          "categoria",
          "preco"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "descricao": {
            "maxLength": 1000,
            "minLength": 5,
            "type": "string"
          },
          "categoria": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "preco": {
            "maximum": 999999,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "dataCriacao": {
            "type": "string",
            "format": "date-time"
          },
          "disponivel": {
            "type": "boolean"
          },
          "caminhoVideo": {
            "type": [
              "null",
              "string"
            ]
          },
          "imagemUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "vendedorId": {
            "type": [
              "null",
              "string"
            ]
          },
          "vendedorGuid": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "criadoPor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProdutoInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "preco": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "disponivel": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "RegistroInput": {
        "required": [
          "nome",
          "email",
          "telefone",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telefone": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "senha": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          }
        }
      },
      "VendaInput": {
        "type": "object",
        "properties": {
          "produtoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
